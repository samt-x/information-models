    opplaring:description_nn "Verksemd som tilbyr pedagogiske tilbod til born, unge eller vaksne." ;
    opplaring:title_en "childhood and youth organisation" ;
    opplaring:title_nn "oppvekstverksemd" .

opplaring:Resultat a owl:Class ;
    rdfs:label "Resultat" ;
    dcterms:title "resultat" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:dokumenteresGjennom ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:gjelder ],
        [ a owl:Restriction ;
            owl:allValuesFrom opplaring:Dokumentasjon ;
