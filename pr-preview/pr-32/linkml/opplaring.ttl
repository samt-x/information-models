<https://modell.samt-bu.no/kjerne/Rolle> a owl:Class ;
    rdfs:label "Rolle" ;
    dcterms:title "rolle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Aktor> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/periode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Tidsperiode> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/periode> ] ;
    skos:closeMatch org:Membership ;
    skos:definition "Funksjon som en aktør har i en bestemt sammenheng i en avgrenset periode." ;
    skos:exactMatch <https://modell.samt-bu.no/kjerne/Rolle> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Function that an agent holds in a particular context for a limited period." ;
    opplaring:description_nn "Funksjon som ein aktør har i ein bestemd samanheng i ein avgrensa periode." ;
    opplaring:title_en "role" ;
    opplaring:title_nn "rolle" .

opplaring:gjelder a owl:ObjectProperty .

<https://modell.samt-bu.no/kjerne/Begrep> a owl:Class ;
    rdfs:label "Begrep" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/iri> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/iri> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/iri> ] ;
    skos:exactMatch skos:Concept ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

opplaring:PedagogiskTilbud a owl:Class ;
    rdfs:label "PedagogiskTilbud" ;
    dcterms:title "pedagogisk tilbud" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom opplaring:Oppvekstvirksomhet ;
            owl:onProperty opplaring:tilbysAv ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:tilbysAv ] ;
    skos:closeMatch elm:LearningOpportunity ;
    skos:definition "Konkret tilbud om opplæring eller annen pedagogisk aktivitet som en oppvekstvirksomhet gir på et bestemt sted i en bestemt periode." ;
    skos:exactMatch opplaring:PedagogiskTilbud ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> ;
    opplaring:description_en "Concrete offer of education or other pedagogical activity that an organisation in the childhood and youth sector provides at a specific place for a specific period." ;
    opplaring:description_nn "Konkret tilbod om opplæring eller anna pedagogisk aktivitet som ei oppvekstverksemd gir på ein bestemd stad i ein bestemd periode." ;
    opplaring:title_en "educational offering" ;
    opplaring:title_nn "pedagogisk tilbod" .

