    opplaring:description_nn "Det fullstendige namnet til personen som éin tekststreng." ;
    opplaring:title_en "full name" ;
    opplaring:title_nn "fullt namn" .

<https://modell.samt-bu.no/kjerne/identifikasjonsnummer> a owl:ObjectProperty ;
    rdfs:label "identifikasjonsnummer" ;
    dcterms:title "identifikasjonsnummer" ;
