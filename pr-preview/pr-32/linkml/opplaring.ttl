    opplaring:title_en "place of death" ;
    opplaring:title_nn "dødsstad" .

<https://modell.samt-bu.no/kjerne/erForesattFor> a owl:ObjectProperty ;
    rdfs:label "erForesattFor" ;
    dcterms:title "er foresatt for" ;
    skos:definition "Angir barnet som rollen gjelder." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Indicates the child to whom the role applies." ;
    opplaring:description_nn "Angir barnet som rolla gjeld." ;
    opplaring:title_en "is guardian of" ;
    opplaring:title_nn "er føresett for" .

<https://modell.samt-bu.no/kjerne/etternavn> a owl:ObjectProperty ;
