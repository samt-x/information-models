opplaring:Deltaker a owl:Class ;
    rdfs:label "Deltaker" ;
    dcterms:title "deltaker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:pameldt ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom opplaring:PedagogiskTilbud ;
            owl:onProperty opplaring:pameldt ],
        [ a owl:Restriction ;
            owl:allValuesFrom opplaring:Resultat ;
            owl:onProperty opplaring:oppnar ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/FysiskPerson> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:oppnar ],
        <https://modell.samt-bu.no/kjerne/Rolle> ;
    skos:closeMatch elm:LearningActivity ;
    skos:definition "Rolle som en fysisk person har når den deltar i et pedagogisk tilbud." ;
    skos:exactMatch opplaring:Deltaker ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> ;
    opplaring:description_en "Role that a natural person holds when participating in an educational offering." ;
    opplaring:description_nn "Rolle som ein fysisk person har når han eller ho deltek i eit pedagogisk tilbod." ;
    opplaring:title_en "participant" ;
    opplaring:title_nn "deltakar" .

opplaring:Dokumentasjon a owl:Class ;
    rdfs:label "Dokumentasjon" ;
    dcterms:title "dokumentasjon" ;
    rdfs:subClassOf [ a owl:Restriction ;
