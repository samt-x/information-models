    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The unambiguous structured reference to the Person." ;
    opplaring:description_nn "Den eintydige, strukturerte referansen til personen." ;
    opplaring:title_en "identifier" ;
    opplaring:title_nn "identifikasjonsnummer" .

<https://modell.samt-bu.no/kjerne/juridiskIdentifikator> a owl:ObjectProperty ;
    rdfs:label "juridiskIdentifikator" ;
    dcterms:title "organisasjonsnummer" ;
    skos:definition "Den entydige, strukturerte referansen som myndigheten som registrerte den juridiske enheten, har tildelt den." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The unambiguous structured reference assigned to the Legal Entity by the legal authority that registered it." ;
    opplaring:description_nn "Den eintydige, strukturerte referansen som styresmakta som registrerte den juridiske eininga, har tildelt henne." ;
    opplaring:title_en "legal identifier" ;
    opplaring:title_nn "organisasjonsnummer" .

<https://modell.samt-bu.no/kjerne/juridiskKjonn> a owl:ObjectProperty ;
    rdfs:label "juridiskKjonn" ;
    dcterms:title "juridisk kjønn" ;
    skos:definition "Personens identiteter, uttrykk og samfunnsroller." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The identities, expressions and societal roles of the Person." ;
    opplaring:description_nn "Identitetane, uttrykka og samfunnsrollene til personen." ;
    opplaring:title_en "gender" ;
    opplaring:title_nn "juridisk kjønn" .

<https://modell.samt-bu.no/kjerne/juridiskNavn> a owl:ObjectProperty ;
    rdfs:label "juridiskNavn" ;
    dcterms:title "navn" ;
    skos:definition "Navnet den juridiske enheten er rettslig registrert under." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The name under which the Legal Entity is legally registered." ;
    opplaring:description_nn "Namnet den juridiske eininga er rettsleg registrert under." ;
    opplaring:title_en "legal name" ;
    opplaring:title_nn "namn" .

<https://modell.samt-bu.no/kjerne/kontaktpunkt> a owl:ObjectProperty ;
    rdfs:label "kontaktpunkt" ;
    dcterms:title "kontaktpunkt" ;
    skos:definition "Den viktigste kontaktinformasjonen for ressursen." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The main contact information of the resource." ;
    opplaring:description_nn "Den viktigaste kontaktinformasjonen for ressursen." ;
    opplaring:title_en "contact point" ;
    opplaring:title_nn "kontaktpunkt" .

<https://modell.samt-bu.no/kjerne/mellomnavn> a owl:ObjectProperty ;
    rdfs:label "mellomnavn" ;
    dcterms:title "mellomnavn" ;
    skos:definition "Ethvert navn personen er kjent under, bortsett fra det fulle navnet." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Any name by which a Person is known, other than their full name." ;
    opplaring:description_nn "Kva som helst namn personen er kjend under, bortsett frå det fulle namnet." ;
    opplaring:title_en "middle name" ;
    opplaring:title_nn "mellomnamn" .

<https://modell.samt-bu.no/kjerne/naringskode> a owl:ObjectProperty ;
    rdfs:label "naringskode" ;
    dcterms:title "næringskode" ;
    skos:definition "Arbeidsområdet den juridiske enheten driver innenfor." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The area of work in which the Legal Entity is engaged." ;
    opplaring:description_nn "Arbeidsområdet den juridiske eininga driv innanfor." ;
    opplaring:title_en "legal entity activity" ;
    opplaring:title_nn "næringskode" .

<https://modell.samt-bu.no/kjerne/navn> a owl:ObjectProperty ;
    rdfs:label "navn" ;
    dcterms:title "navn" ;
    skos:definition "Organisasjonens hovednavn." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The primary name of the organization." ;
    opplaring:description_nn "Hovudnamnet til organisasjonen." ;
    opplaring:title_en "name" ;
    opplaring:title_nn "namn" .

<https://modell.samt-bu.no/kjerne/opprinneligNavn> a owl:DatatypeProperty ;
    rdfs:label "opprinneligNavn" ;
    dcterms:title "opprinnelig navn" ;
    skos:closeMatch <http://www.w3.org/ns/person#birthName> ;
    skos:definition "Navn før navneendring av ulike årsaker, for eksempel pikenavn." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Name before a change of name for various reasons, for example maiden name." ;
    opplaring:description_nn "Namn før namneendring av ulike årsaker, til dømes jentenamn." ;
    opplaring:title_en "original name" ;
    opplaring:title_nn "opphavleg namn" .

<https://modell.samt-bu.no/kjerne/organisasjonsform> a owl:ObjectProperty ;
    rdfs:label "organisasjonsform" ;
    dcterms:title "organisasjonsform" ;
    skos:definition "Klassifiseringen av den juridiske enheten som medlem av en bestemt gruppe i forbindelse med rettslig registrering." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The classification of the Legal Entity as a member of a particular group in the context of legal registration." ;
    opplaring:description_nn "Klassifiseringa av den juridiske eininga som medlem av ei bestemd gruppe i samband med rettsleg registrering." ;
    opplaring:title_en "legal form type" ;
    opplaring:title_nn "organisasjonsform" .

<https://modell.samt-bu.no/kjerne/organisasjonsnummer> a owl:ObjectProperty ;
    rdfs:label "organisasjonsnummer" ;
    dcterms:title "organisasjonsnummer" ;
