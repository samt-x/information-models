@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix elm: <http://data.europa.eu/snb/model/elm/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix opplaring: <https://modell.samt-bu.no/opplaring/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://modell.samt-bu.no/kjerne/JuridiskEnhet> a owl:Class ;
    rdfs:label "JuridiskEnhet" ;
    dcterms:title "juridisk enhet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/organisasjonsform> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Begrep> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/naringskode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Any> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/juridiskNavn> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Begrep> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/organisasjonsform> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/naringskode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Identifikator> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/juridiskIdentifikator> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/juridiskIdentifikator> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/juridiskNavn> ] ;
    skos:definition "En selvstendig næringsdrivende, et selskap eller en organisasjon som har juridiske rettigheter og plikter." ;
    skos:exactMatch <http://www.w3.org/ns/legal#LegalEntity> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_nn "Ein sjølvstendig næringsdrivande, eit selskap eller ein organisasjon som har juridiske rettar og plikter." ;
    opplaring:title_nn "juridisk eining" .

<https://modell.samt-bu.no/opplaring.owl.ttl> a owl:Ontology ;
    rdfs:label "opplaring" ;
    dcterms:license "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0" ;
    dcterms:title "Domenemodul for opplæring" ;
    pav:version "0.5.0" ;
    skos:definition "Klasser og relasjoner for opplæringsområdet i oppvekstsektoren." ;
    opplaring:description_en "Classes and relations for education in the childhood and youth sector." ;
    opplaring:description_nn "Klassar og relasjonar for opplæringsområdet i oppvekstsektoren." ;
    opplaring:title_en "Domain module for education" ;
    opplaring:title_nn "Domenemodul for opplæring" .

<https://modell.samt-bu.no/kjerne/Adresse> a owl:Class ;
    rdfs:label "Adresse" ;
    skos:exactMatch <http://www.w3.org/ns/locn#Address> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

<https://modell.samt-bu.no/kjerne/Foresatt> a owl:Class ;
    rdfs:label "Foresatt" ;
    dcterms:title "foresatt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/FysiskPerson> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/FysiskPerson> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erForesattFor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erForesattFor> ],
        <https://modell.samt-bu.no/kjerne/Rolle> ;
    skos:definition "Rolle som en fysisk person har når den har ansvar for et barn." ;
    skos:exactMatch <https://modell.samt-bu.no/kjerne/Foresatt> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Role that a natural person holds when responsible for a child." ;
    opplaring:description_nn "Rolle som ein fysisk person har når han eller ho har ansvar for eit barn." ;
    opplaring:title_en "guardian" ;
    opplaring:title_nn "føresett" .

<https://modell.samt-bu.no/kjerne/Kontaktpunkt> a owl:Class ;
    rdfs:label "Kontaktpunkt" ;
    skos:exactMatch <http://data.europa.eu/m8g/ContactPoint> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

<https://modell.samt-bu.no/kjerne/Tidsperiode> a owl:Class ;
    rdfs:label "Tidsperiode" ;
    skos:exactMatch dcterms:PeriodOfTime ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

opplaring:Ansatt a owl:Class ;
    rdfs:label "Ansatt" ;
    dcterms:title "ansatt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Virksomhet> ;
            owl:onProperty opplaring:arbeidsgiver ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:utforer ],
        [ a owl:Restriction ;
            owl:allValuesFrom opplaring:PedagogiskTilbud ;
            owl:onProperty opplaring:utforer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty opplaring:arbeidsgiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/FysiskPerson> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/erRolleFor> ],
        <https://modell.samt-bu.no/kjerne/Rolle>,
        opplaring:Organisasjonsmedlemskap ;
    skos:definition "Rolle som en fysisk person har i kraft av et ansettelsesforhold." ;
    skos:exactMatch opplaring:Ansatt ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> ;
    opplaring:description_en "Role that a natural person holds by virtue of an employment relationship." ;
    opplaring:description_nn "Rolle som ein fysisk person har i kraft av eit tilsetjingsforhold." ;
    opplaring:title_en "employee" ;
    opplaring:title_nn "tilsett" .

opplaring:Organisasjonsmedlemskap a owl:Class ;
    rdfs:label "Organisasjonsmedlemskap" ;
    skos:exactMatch org:Membership ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> .

opplaring:StotteOgHjelpevirksomhet a owl:Class ;
    rdfs:label "StotteOgHjelpevirksomhet" ;
    dcterms:title "støtte- og hjelpevirksomhet" ;
    skos:definition "Virksomhet som gir støtte til oppvekstvirksomheter eller deltakere uten selv å tilby pedagogiske tilbud." ;
    skos:exactMatch opplaring:StotteOgHjelpevirksomhet ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> ;
    opplaring:description_en "Organisation that supports childhood and youth organisations or participants without itself providing educational offerings." ;
    opplaring:description_nn "Verksemd som gir støtte til oppvekstverksemder eller deltakarar utan sjølv å tilby pedagogiske tilbod." ;
    opplaring:title_en "support organisation" ;
    opplaring:title_nn "støtte- og hjelpeverksemd" .

<https://modell.samt-bu.no/kjerne/Identifikator> a owl:Class ;
    rdfs:label "Identifikator" ;
    skos:exactMatch <http://www.w3.org/ns/adms#Identifier> ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

<https://modell.samt-bu.no/kjerne/Jurisdiksjon> a owl:Class ;
    rdfs:label "Jurisdiksjon" ;
    skos:exactMatch dcterms:Jurisdiction ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

<https://modell.samt-bu.no/kjerne/Sted> a owl:Class ;
    rdfs:label "Sted" ;
    skos:exactMatch dcterms:Location ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> .

<https://modell.samt-bu.no/kjerne/Virksomhet> a owl:Class ;
    rdfs:label "Virksomhet" ;
    dcterms:title "organisasjon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Any> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/organisasjonsnummer> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/navn> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/organisasjonsnummer> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://modell.samt-bu.no/kjerne/Any> ;
            owl:onProperty <https://modell.samt-bu.no/kjerne/navn> ],
        <https://modell.samt-bu.no/kjerne/Aktor> ;
    skos:altLabel "virksomhet" ;
    skos:definition "En samling mennesker organisert i et fellesskap eller en annen sosial, kommersiell eller politisk struktur. Gruppen har et felles formål eller en grunn til å eksistere som går ut over de enkelte medlemmene, og den kan opptre som en aktør." ;
    skos:exactMatch org:Organization ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_nn "Ei samling menneske organisert i eit fellesskap eller ein annan sosial, kommersiell eller politisk struktur. Gruppa har eit felles føremål eller ein grunn til å eksistere som går ut over dei einskilde medlemene, og ho kan opptre som ein aktør." ;
    opplaring:title_nn "organisasjon" .

<https://modell.samt-bu.no/kjerne/biologiskKjonn> a owl:ObjectProperty ;
    rdfs:label "biologiskKjonn" ;
    dcterms:title "biologisk kjønn" ;
    skos:definition "Organismens biologiske kjønn." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The organism's biological sex." ;
    opplaring:description_nn "Det biologiske kjønnet til organismen." ;
    opplaring:title_en "sex" ;
    opplaring:title_nn "biologisk kjønn" .

<https://modell.samt-bu.no/kjerne/bostedsadresse> a owl:ObjectProperty ;
    rdfs:label "bostedsadresse" ;
    dcterms:title "bostedsadresse" ;
