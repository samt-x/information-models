    opplaring:title_en "date of birth" ;
    opplaring:title_nn "fødselsdato" .

<https://modell.samt-bu.no/kjerne/folkeregistrertAdresse> a owl:ObjectProperty ;
    rdfs:label "folkeregistrertAdresse" ;
    dcterms:title "folkeregistrert adresse" ;
