    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "Jurisdiction where the Person has their dwelling." ;
    opplaring:description_nn "Jurisdiksjonen der personen har bustaden sin." ;
    opplaring:title_en "residency" ;
    opplaring:title_nn "folkeregistrert adresse" .

<https://modell.samt-bu.no/kjerne/fornavn> a owl:ObjectProperty ;
    rdfs:label "fornavn" ;
    dcterms:title "fornavn" ;
    skos:definition "Navnet eller navnene som identifiserer personen innenfor en familie med felles etternavn." ;
    skos:inScheme <https://modell.samt-bu.no/kjerne> ;
    opplaring:description_en "The name(s) that identify the Person within a family with a common surname." ;
    opplaring:description_nn "Namnet eller namna som identifiserer personen innanfor ein familie med felles etternamn." ;
    opplaring:title_en "given name" ;
    opplaring:title_nn "førenamn" .

<https://modell.samt-bu.no/kjerne/fulltNavn> a owl:ObjectProperty ;
    rdfs:label "fulltNavn" ;
    dcterms:title "fullt navn" ;
