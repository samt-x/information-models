            owl:onProperty opplaring:gjelder ],
        [ a owl:Restriction ;
            owl:allValuesFrom opplaring:Deltaker ;
            owl:onProperty opplaring:gjelder ] ;
    skos:definition "Dokument eller registrering som viser et resultat for en deltaker." ;
    skos:exactMatch opplaring:Dokumentasjon ;
    skos:inScheme <https://modell.samt-bu.no/opplaring> ;
